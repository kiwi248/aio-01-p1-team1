SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI 상담은 기본 mock 모드로 실행됩니다.
# 실제 Gemini 호출 시 CHAT_GEMINI_MODE=gemini로 바꾸고 API key를 입력합니다.
CHAT_GEMINI_MODE=mock
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
CHAT_HISTORY_LIMIT=10

# preview는 Supabase에 쓰지 않고 테스트 백엔드 메모리에만 요약을 보관합니다.
CHAT_SUMMARY_STORAGE=preview

KAKAO_REST_API_KEY=your-kakao-rest-api-key

# 배포한 Streamlit Cloud 앱 주소를 쉼표로 구분해 넣습니다.
# 비워두면 전체 도메인을 허용합니다.
ALLOWED_ORIGINS=*